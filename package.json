{
  "name": "game-lsd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check:content": "node scripts/check-content.js",
    "check:assets": "node scripts/check-assets.js",
    "format": "prettier --write src scripts tests vite.config.js index.html",
    "format:check": "prettier --check src scripts tests vite.config.js index.html",
    "check": "npm run format:check && npm test && npm run check:content && npm run check:assets && npm run build"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "vite": "8.3.1"
  }
}
